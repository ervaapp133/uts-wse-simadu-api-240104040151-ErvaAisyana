# Konfigurasi Server SIMADU API
# Salin file ini menjadi .env sebelum menjalankan server

PORT=3000
NODE_ENV=development

# Konfigurasi JWT (Ganti dengan secret key yang kuat dan acak)
JWT_SECRET=simadu-uts-wse-2026-erva-aisyana-secret-key-ganti-di-produksi
JWT_EXPIRES_IN=1h

# Pengembangan Tambahan (Opsional - Soal 3)
# Ubah ke true jika ingin mengaktifkan validasi header x-api-key selain Bearer Token
ENABLE_API_KEY=false
API_KEY=simadu-client-key-2026
